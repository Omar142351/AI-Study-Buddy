# Copy this file to .env and fill it in. NEVER commit .env.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# true = use built-in fake answers (no key needed, no cost). Great while learning.
MOCK_AI=true

# Protect your key on a public site
RATE_LIMIT_PER_MINUTE=8
DAILY_AI_CALL_LIMIT=200
